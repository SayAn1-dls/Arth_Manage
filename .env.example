# Copy to .env and adjust. Placeholders only — never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arthakram
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arthakram_test
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin of the site. Must be https:// in production.
APP_BASE_URL=http://localhost:5173
API_PORT=4000
STORAGE_DIR=./.data/uploads

# Email. `console` records messages in a dev outbox only; production requires `smtp`.
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=Arthakram <no-reply@localhost>

# Optional Google Sheets / Drive integration. Leave empty and the screens say "not configured".
# Redirect URI to register in Google Cloud: {APP_BASE_URL}/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes as 64 hex characters (`openssl rand -hex 32`). Encrypts stored Google tokens. Keep it outside the database.
TOKEN_ENCRYPTION_KEY=

# Only for local development and browser tests; leave unset (rate limits on) in production
RATE_LIMIT_DISABLED=false

# Optional judge reading aid. Source-based cards work without AI.
# Enable only after agreeing to send project title/summary and public README excerpts to OpenAI.
OPENAI_API_KEY=
JUDGE_SUMMARY_MODEL=
JUDGE_AI_ENABLED=false
